generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  fullName       String          @map("full_name")
  role           String          @default("PATIENT")
  phone          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  patientAppts   Appointment[]   @relation("PatientAppointments")
  bedAssignments Bed[]           @relation("BedPatient")
  doctorProfile  Doctor?         @relation("DoctorProfile")
  invoices       Invoice[]       @relation("PatientInvoices")
  patientRecords MedicalRecord[] @relation("PatientRecords")

  @@index([role])
  @@index([email])
  @@map("users")
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  headDoctorId String?  @unique @map("head_doctor_id")
  location     String?
  phone        String?
  icon         String   @default("🏥")
  color        String   @default("bg-blue-50 text-blue-600")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  beds         Bed[]
  headDoctor   Doctor?  @relation("DepartmentHead", fields: [headDoctorId], references: [id])
  doctors      Doctor[] @relation("DepartmentDoctors")

  @@index([headDoctorId])
  @@map("departments")
}

model Doctor {
  id             String          @id @default(cuid())
  userId         String          @unique @map("user_id")
  specialization String
  licenseNumber  String          @map("license_number")
  fee            Float           @default(0)
  roomNumber     String?         @map("room_number")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  departmentId   String?         @map("department_id")
  appointments   Appointment[]   @relation("DoctorAppointments")
  bedAssignments Bed[]           @relation("BedDoctor")
  headOf         Department?     @relation("DepartmentHead")
  department     Department?     @relation("DepartmentDoctors", fields: [departmentId], references: [id])
  user           User            @relation("DoctorProfile", fields: [userId], references: [id], onDelete: Cascade)
  medicalRecords MedicalRecord[] @relation("DoctorMedicalRecords")

  @@index([specialization])
  @@index([userId])
  @@index([departmentId])
  @@map("doctors")
}

model Appointment {
  id            String         @id @default(cuid())
  patientId     String         @map("patient_id")
  doctorId      String         @map("doctor_id")
  date          String
  timeSlot      String         @map("time_slot")
  status        String         @default("PENDING")
  reason        String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  doctor        Doctor         @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User           @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  invoice       Invoice?
  medicalRecord MedicalRecord?

  @@unique([doctorId, date, timeSlot])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@index([doctorId, date])
  @@index([patientId, status])
  @@map("appointments")
}

model MedicalRecord {
  id            String      @id @default(cuid())
  appointmentId String      @unique @map("appointment_id")
  patientId     String      @map("patient_id")
  doctorId      String?     @map("doctor_id")
  diagnosis     String
  prescription  String      @default("[]")
  vitalsJson    String      @default("{}") @map("vitals_json")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor?     @relation("DoctorMedicalRecords", fields: [doctorId], references: [id])
  patient       User        @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
  @@map("medical_records")
}

model Bed {
  id            String      @id @default(cuid())
  number        String      @unique
  ward          String
  departmentId  String?     @map("department_id")
  status        String      @default("available")
  patientId     String?     @map("patient_id")
  doctorId      String?     @map("doctor_id")
  admittedSince DateTime?   @map("admitted_since")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  department    Department? @relation(fields: [departmentId], references: [id])
  doctor        Doctor?     @relation("BedDoctor", fields: [doctorId], references: [id])
  patient       User?       @relation("BedPatient", fields: [patientId], references: [id])

  @@index([status])
  @@index([ward])
  @@index([departmentId])
  @@map("beds")
}

model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique
  patientId     String       @map("patient_id")
  appointmentId String?      @unique @map("appointment_id")
  description   String
  amount        Float
  status        String       @default("pending")
  method        String?
  dueDate       DateTime?    @map("due_date")
  paidAt        DateTime?    @map("paid_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       User         @relation("PatientInvoices", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("invoices")
}
